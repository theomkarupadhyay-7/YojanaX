from fastapi import FastAPI

from backend.app.api.routes.eligibility import (
    router as eligibility_router,
)

from backend.app.api.routes.schemes import (
    router as schemes_router,
)

from backend.app.api.routes.partners import (
    router as partners_router,
)

from backend.app.api.routes.calculator import (
    router as calculator_router,
)


app = FastAPI(
    title="Scheme Setu API",
    description=(
        "AI-driven scheme matching platform "
        "for marginalized entrepreneurs."
    ),
    version="0.1.0",
)


app.include_router(
    eligibility_router
)

app.include_router(
    schemes_router
)

app.include_router(
    partners_router
)

app.include_router(
    calculator_router
)


@app.get("/")
def root():
    return {
        "message": "Scheme Setu API is running."
    }